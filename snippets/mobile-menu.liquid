<div class="paw-drawer" id="PawMobileMenu-{{ section.id }}" hidden data-mobile-drawer aria-hidden="true"><div class="paw-drawer__overlay" data-drawer-close></div><aside class="paw-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1"><div class="paw-drawer__top"><span>{{ shop.name }}</span><button type="button" data-drawer-close aria-label="Close menu">{% render 'header-icons', icon: 'close' %}</button></div><nav aria-label="Mobile navigation"><ul role="list">{%- for link in section.settings.menu.links -%}<li>{%- if link.links != blank -%}<details><summary>{{ link.title | escape }} {% render 'header-icons', icon: 'chevron-down' %}</summary><ul role="list">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a>{%- if child.links != blank -%}<ul role="list">{%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>{%- endfor -%}</ul>{%- endif -%}</li>{%- endfor -%}</ul></details>{%- else -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endif -%}</li>{%- endfor -%}</ul></nav></aside></div>
