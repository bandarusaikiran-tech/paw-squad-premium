<div class="paw-mega-menu" id="MegaMenu-{{ section.id }}-{{ index }}" hidden><div class="paw-mega-menu__inner page-width"><div class="paw-mega-menu__links">{%- for child in link.links -%}<div class="paw-mega-menu__column"><a class="paw-mega-menu__heading" href="{{ child.url }}">{{ child.title | escape }}</a>{%- if child.links != blank -%}<ul role="list">{%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>{%- endfor -%}</ul>{%- endif -%}</div>{%- endfor -%}</div>{%- if section.settings.mega_collection != blank or section.settings.mega_image != blank or section.settings.mega_heading != blank -%}<aside class="paw-mega-menu__promo">{%- if section.settings.mega_image != blank -%}{{ section.settings.mega_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '320px', alt: section.settings.mega_image.alt | default: section.settings.mega_heading }}{%- elsif section.settings.mega_collection.featured_image != blank -%}{{ section.settings.mega_collection.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '320px', alt: section.settings.mega_collection.title }}{%- endif -%}<div><p>{{ section.settings.mega_eyebrow | escape }}</p><h2>{{ section.settings.mega_heading | default: section.settings.mega_collection.title | escape }}</h2>{% if section.settings.mega_text != blank %}<p>{{ section.settings.mega_text | escape }}</p>{% endif %}{% if section.settings.mega_link != blank %}<a href="{{ section.settings.mega_link }}">{{ section.settings.mega_link_label | default: 'Explore' | escape }}</a>{% endif %}</div></aside>{%- endif -%}</div></div>
