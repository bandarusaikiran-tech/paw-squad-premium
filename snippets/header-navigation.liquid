<nav class="paw-header__navigation" aria-label="Primary navigation"><ul class="paw-nav" role="list">{%- for link in section.settings.menu.links -%}<li class="paw-nav__item">{%- if link.links != blank -%}<button class="paw-nav__toggle" type="button" aria-expanded="false" aria-controls="MegaMenu-{{ section.id }}-{{ forloop.index }}">{{ link.title | escape }} {% render 'header-icons', icon: 'chevron-down' %}</button>{% render 'mega-menu', link: link, index: forloop.index %}{%- else -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endif -%}</li>{%- endfor -%}</ul></nav>
