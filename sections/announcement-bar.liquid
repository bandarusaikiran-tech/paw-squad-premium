{{ 'announcement.css' | asset_url | stylesheet_tag }}
<announcement-bar class="paw-announcement color-{{ section.settings.color_scheme }}" data-rotate="{{ section.settings.auto_rotate }}" data-interval="{{ section.settings.rotation_speed | times: 1000 }}" {% if section.settings.show_dismiss %}data-dismissible{% endif %}>
  <div class="paw-announcement__inner" role="region" aria-label="Announcements"><div class="paw-announcement__track" aria-live="polite">
    {%- for block in section.blocks -%}<div class="paw-announcement__item{% if forloop.first %} is-active{% endif %}" data-announcement-item {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>{% render 'announcement-item', block: block %}</div>{%- else -%}<div class="paw-announcement__item is-active" data-announcement-item>{% render 'announcement-item', text: 'Welcome to Paw Squad' %}</div>{%- endfor -%}
  </div>{% if section.blocks.size > 1 %}<div class="paw-announcement__controls"><button class="paw-announcement__control" type="button" data-announcement-previous aria-label="Previous announcement">{% render 'header-icons', icon: 'chevron-left' %}</button><button class="paw-announcement__control" type="button" data-announcement-next aria-label="Next announcement">{% render 'header-icons', icon: 'chevron-right' %}</button></div>{% endif %}{% if section.settings.show_dismiss %}<button class="paw-announcement__dismiss" type="button" data-announcement-dismiss aria-label="Dismiss announcements">{% render 'header-icons', icon: 'close' %}</button>{% endif %}</div>
</announcement-bar>
{% schema %}{"name":"Announcement bar","class":"announcement-bar-section","enabled_on":{"groups":["header"]},"max_blocks":6,"settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-4"},{"type":"checkbox","id":"auto_rotate","label":"Rotate announcements automatically","default":false},{"type":"range","id":"rotation_speed","min":3,"max":10,"step":1,"unit":"s","label":"Rotation speed","default":5},{"type":"checkbox","id":"show_dismiss","label":"Show dismiss button","default":false}],"blocks":[{"type":"announcement","name":"Announcement","settings":[{"type":"text","id":"text","label":"Text","default":"Complimentary shipping on orders over ₹2,500"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Announcement bar","blocks":[{"type":"announcement"}]}]}{% endschema %}
