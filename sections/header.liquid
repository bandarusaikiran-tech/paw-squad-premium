{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'navigation.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}
{{ 'mobile-menu.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

<header class="paw-header-section{% if section.settings.transparent_on_home and request.page_type == 'index' %} paw-header-section--transparent{% endif %}" data-paw-header>
  <div class="paw-header page-width">
    <button class="paw-header__menu-button" type="button" data-drawer-open aria-expanded="false" aria-controls="PawMobileMenu-{{ section.id }}" aria-label="Open menu">{% render 'header-icons', icon: 'menu' %}</button>
    {% render 'header-logo' %}
    {% render 'header-navigation' %}
    <div class="paw-header__actions">
      {% render 'header-search', input_id: 'PawHeaderSearch' %}
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}" class="paw-header__action paw-header__action--desktop" aria-label="Account">{% render 'header-icons', icon: 'account' %}</a>{%- endif -%}
      {%- if section.settings.show_wishlist -%}<a href="{{ section.settings.wishlist_url | default: routes.root_url }}" class="paw-header__action paw-header__action--desktop" aria-label="Wishlist">{% render 'header-icons', icon: 'heart' %}</a>{%- endif -%}
      <a href="{{ routes.cart_url }}" class="paw-header__action paw-header__cart" aria-label="Cart, {{ cart.item_count }} items">{% render 'header-icons', icon: 'bag' %}<span class="paw-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>
{% render 'mobile-menu' %}

{% schema %}
{"name":"Header","class":"section-header","enabled_on":{"groups":["header"]},"settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"checkbox","id":"transparent_on_home","label":"Transparent over homepage hero","default":false},{"type":"checkbox","id":"show_wishlist","label":"Show wishlist placeholder","default":true},{"type":"url","id":"wishlist_url","label":"Wishlist link"},{"type":"header","content":"Mega menu promotion"},{"type":"collection","id":"mega_collection","label":"Featured collection"},{"type":"image_picker","id":"mega_image","label":"Editorial image"},{"type":"text","id":"mega_eyebrow","label":"Eyebrow"},{"type":"text","id":"mega_heading","label":"Heading"},{"type":"text","id":"mega_text","label":"Text"},{"type":"url","id":"mega_link","label":"CTA link"},{"type":"text","id":"mega_link_label","label":"CTA label","default":"Explore collection"}]}
{% endschema %}
